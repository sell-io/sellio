<h1 style="font-size:18px; margin:0 0 16px;">
  <%= @listings.count %> new <%= 'listing'.pluralize(@listings.count) %> for "<%= @saved_search.name %>" 🔎
</h1>

<% @listings.each do |listing| %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:16px; border-bottom:1px solid #e5e7eb; padding-bottom:16px;">
    <tr>
      <td>
        <a href="<%= listing_url(listing) %>" style="color:#2B2F33; text-decoration:none; font-weight:600; font-size:15px;">
          <%= listing.title %>
        </a>
        <p style="margin:4px 0 0; color:#4FD1A5; font-weight:700;">€<%= number_with_delimiter(listing.price.to_i) %></p>
        <p style="margin:4px 0 0; color:#6b7280; font-size:13px;"><%= listing.city %></p>
      </td>
    </tr>
  </table>
<% end %>

<p style="margin:16px 0 0;">
  <a href="<%= listings_url(@saved_search.query_params.symbolize_keys) %>" style="display:inline-block; background-color:#4FD1A5; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:600;">
    See all results
  </a>
</p>

<p style="margin:24px 0 0; color:#6b7280; font-size:13px;">
  You're getting this because you saved the search "<%= @saved_search.name %>" on Dealo.
</p>
