<h1 style="font-size:18px; margin:0 0 16px;">Price drop on a listing you saved 📉</h1>

<p style="margin:0 0 16px;">
  <strong><%= @listing.title %></strong> just dropped from
  €<%= number_with_delimiter(@listing.previous_price.to_i) %> to
  <strong style="color:#4FD1A5;">€<%= number_with_delimiter(@listing.price.to_i) %></strong>.
</p>

<p style="margin:0 0 24px;">
  <a href="<%= listing_url(@listing) %>" style="display:inline-block; background-color:#4FD1A5; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-weight:600;">
    View listing
  </a>
</p>

<p style="margin:0; color:#6b7280; font-size:13px;">
  You're getting this because you saved this listing as a favorite on Dealo.
</p>
